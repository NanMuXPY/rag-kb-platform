                <Text style={{ fontSize: 15, color: '#8B97A8' }}>拒答准确率（15 道该拒答题）</Text>
                <Box style={{ flexDirection: 'row', alignItems: 'flex-end', marginTop: 4 }}>
                    <Text style={{ fontSize: 70, color: '#1E4FA8', fontWeight: 'bold', lineHeight: 1 }}>93.3</Text>
                    <Text style={{ fontSize: 22, color: '#1E4FA8', marginBottom: 9, marginLeft: 4 }}>%</Text>
                </Box>
                <Text style={{ fontSize: 15, color: '#4A5568', marginTop: 8 }}>14/15，起点为 v1 的 80%</Text>
            </Box>
            <Box style={{ width: 1, background: '#D6DCE5' }} />
            <Box style={{ flex: 1, flexDirection: 'column', justifyContent: 'flex-end' }}>
