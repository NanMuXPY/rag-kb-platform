                <Box style={{ flexDirection: 'row', alignItems: 'flex-end', marginTop: 4 }}>
                    <Text style={{ fontSize: 70, color: '#1E4FA8', fontWeight: 'bold', lineHeight: 1 }}>2</Text>
                    <Text style={{ fontSize: 22, color: '#1E4FA8', marginBottom: 9, marginLeft: 6 }}>次</Text>
                </Box>
                <Text style={{ fontSize: 15, color: '#4A5568', marginTop: 8 }}>两轮 2 / 3，起点 17 次</Text>
            </Box>
            <Box style={{ width: 1, background: '#D6DCE5' }} />
            <Box style={{ flex: 1, flexDirection: 'column', justifyContent: 'flex-end' }}>
                <Text style={{ fontSize: 15, color: '#8B97A8' }}>端到端 P95 延迟</Text>
                <Box style={{ flexDirection: 'row', alignItems: 'flex-end', marginTop: 4 }}>
                    <Text style={{ fontSize: 70, color: '#1E4FA8', fontWeight: 'bold', lineHeight: 1 }}>17.3</Text>
                    <Text style={{ fontSize: 22, color: '#1E4FA8', marginBottom: 9, marginLeft: 4 }}>s</Text>
                </Box>
                <Text style={{ fontSize: 15, color: '#4A5568', marginTop: 8 }}>起点 58.4s，降 70%</Text>
            </Box>
        </Box>
        <Box style={{ height: 1, background: '#D6DCE5' }} />
        <Table
            style={{ width: '100%', height: 268 }}
