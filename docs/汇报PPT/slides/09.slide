<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: 0, flexDirection: 'column' }}>
    <Box style={{ height: 68, background: '#1E4FA8', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', paddingLeft: 60, paddingRight: 60 }}>
        <Text style={{ fontSize: 34, color: '#FFFFFF', fontWeight: 'bold' }}>权限下沉到检索层：查不到，而不是查完再过滤</Text>
        <Text style={{ fontSize: 15, color: '#FFFFFF', opacity: 0.72 }}>02 · Governance</Text>
    </Box>
    <Box style={{ flex: 1, flexDirection: 'column', paddingLeft: 60, paddingRight: 60, paddingTop: 24, paddingBottom: 10, gap: 20 }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', background: '#E8EFF8', borderLeft: '4px solid #1E4FA8', paddingTop: 12, paddingBottom: 12, paddingLeft: 20, paddingRight: 20 }}>
            <Text style={{ fontSize: 19, color: '#1A2230', lineHeight: 1.4 }}>
                <span style={{ fontWeight: 'bold' }}>设计要点　</span>每个 chunk 打上 kb_id 元数据，检索时按用户可见库集合过滤——权限在向量库里就生效，不是查完再筛。
            </Text>
        </Box>
        <Box style={{ flexDirection: 'row', gap: 40, flex: 1 }}>
            <Box style={{ width: 466, flexDirection: 'column' }}>
                <Text style={{ fontSize: 20, color: '#1A2230', fontWeight: 'bold' }}>两级角色，各管一层</Text>
                <Box style={{ height: 1, background: '#D6DCE5', marginTop: 10, marginBottom: 12 }} />
                <Table
                    style={{ width: '100%', height: 350 }}
                    defaultTextStyle={{ fontSize: 16, textAlign: 'left', color: '#1A2230' }}
                    defaultCellStyle={{ border: { bottom: { width: 1, color: '#E5E7EB' } } }}
                    cells={[
                        [
                            { text: '角色', textStyle: { bold: true, color: '#FFFFFF' }, cellStyle: { background: { color: '#1E4FA8' }, border: { bottom: { width: 1, color: '#1E4FA8' } } } },
                            { text: '权限边界', textStyle: { bold: true, color: '#FFFFFF' }, cellStyle: { background: { color: '#1E4FA8' }, border: { bottom: { width: 1, color: '#1E4FA8' } } } },
                        ],
                        [{ text: 'superadmin', textStyle: { bold: true, color: '#1E4FA8' } }, { text: '跨全库语义搜索、建库删库' }],
                        [{ text: 'admin', textStyle: { color: '#4A5568' } }, { text: '用户审批与知识库管理' }],
                        [{ text: 'user', textStyle: { color: '#4A5568' } }, { text: '仅在授权库内问答与下载' }],
                        [{ text: 'kb_admin', textStyle: { bold: true, color: '#1E4FA8' } }, { text: '库内审批、成员授权' }],
                        [{ text: 'editor', textStyle: { color: '#4A5568' } }, { text: '可上传，但必须等审批' }],
                        [{ text: 'viewer', textStyle: { color: '#4A5568' } }, { text: '只读、可下载，不可改' }],
                    ]}
                />
            </Box>
            <Box style={{ flex: 1, flexDirection: 'column' }}>
                <Text style={{ fontSize: 20, color: '#1A2230', fontWeight: 'bold' }}>一次上传要过四道校验</Text>
                <Box style={{ height: 1, background: '#D6DCE5', marginTop: 10, marginBottom: 12 }} />
                <Box style={{ flexDirection: 'row', alignItems: 'flex-start', paddingBottom: 11, borderBottom: '1px solid #E5E7EB' }}>
                    <Text style={{ fontSize: 20, color: '#3D7BD9', fontWeight: 'bold', width: 40 }}>01</Text>
                    <Text style={{ fontSize: 18, color: '#1A2230', lineHeight: 1.4 }}>editor 提交文件 → 状态置 <span style={{ fontWeight: 'bold' }}>pending</span>，不进检索</Text>
                </Box>
                <Box style={{ flexDirection: 'row', alignItems: 'flex-start', paddingTop: 11, paddingBottom: 11, borderBottom: '1px solid #E5E7EB' }}>
                    <Text style={{ fontSize: 20, color: '#3D7BD9', fontWeight: 'bold', width: 40 }}>02</Text>
                    <Text style={{ fontSize: 18, color: '#1A2230', lineHeight: 1.4 }}>kb_admin 批准 → <span style={{ fontWeight: 'bold' }}>增量</span>写入向量库，无需全量重建</Text>
                </Box>
                <Box style={{ flexDirection: 'row', alignItems: 'flex-start', paddingTop: 11, paddingBottom: 11, borderBottom: '1px solid #E5E7EB' }}>
                    <Text style={{ fontSize: 20, color: '#3D7BD9', fontWeight: 'bold', width: 40 }}>03</Text>
                    <Text style={{ fontSize: 18, color: '#1A2230', lineHeight: 1.4 }}>同名覆盖 → 旧版本落 <span style={{ fontWeight: 'bold' }}>.versions/</span>，可回溯</Text>
                </Box>
                <Box style={{ flexDirection: 'row', alignItems: 'flex-start', paddingTop: 11, paddingBottom: 11 }}>
                    <Text style={{ fontSize: 20, color: '#3D7BD9', fontWeight: 'bold', width: 40 }}>04</Text>
                    <Text style={{ fontSize: 18, color: '#1A2230', lineHeight: 1.4 }}>删除 → 落 <span style={{ fontWeight: 'bold' }}>.trash/</span> 回收站，可恢复</Text>
                </Box>
                <Box style={{ flex: 1 }} />
                <Box style={{ background: '#1E4FA8', paddingTop: 13, paddingBottom: 13, paddingLeft: 18, paddingRight: 18 }}>
                    <Text style={{ fontSize: 17, color: '#FFFFFF', lineHeight: 1.45 }}>
                        全操作写 audit_log：<span style={{ fontWeight: 'bold' }}>谁 · 何时 · 哪个库 · 哪个文件</span>
                    </Text>
                </Box>
            </Box>
        </Box>
    </Box>
    <Box style={{ height: 50, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'flex-start', paddingTop: 8, paddingLeft: 60, paddingRight: 60 }}>
        <Text style={{ fontSize: 14, color: '#8B97A8' }}>企业内部技术支持知识库 · 课程作业汇报</Text>
        <Text style={{ fontSize: 14, color: '#8B97A8' }}>09 / 18</Text>
    </Box>
</Slide>
